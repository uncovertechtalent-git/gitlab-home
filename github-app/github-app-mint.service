[Unit]
Description=Mint GitHub App installation tokens into the files services read
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/github-app-mint
Environment=GITHUB_APP_MINT_CONF_DIR=/etc/github-app-mint
# Private keys are systemd credentials: files /etc/credstore/github-app.<app>.pem (root, mode 600)
# appear for this service only, under $CREDENTIALS_DIRECTORY.
ImportCredential=github-app.*
# Root, because each output file is owned by the service that reads it (chown). Everything else is
# read-only; the job may write only into the folders that hold the token files. Those folders are
# host-specific: list them in a drop-in, /etc/systemd/system/github-app-mint.service.d/paths.conf:
#   [Service]
#   ReadWritePaths=/home/<user>/services/agent-observability/deploy-exporter/tokens
#   ReadWritePaths=/home/<user>/services/agent-observability/alert-issues/secrets
PrivateTmp=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
TimeoutStartSec=2min
