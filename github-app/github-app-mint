#!/usr/bin/env bash
# Mint short-lived GitHub App installation tokens into the files that services already read.
#
# A GitHub App signs a JSON Web Token with its private key, trades it for an installation token
# (valid one hour), and the token can be narrowed to some repositories and some permissions. This
# job runs every 30 minutes, so every file always holds a token with at least 30 minutes left.
# No token is ever renewed by hand and none expires on a calendar.
#
# Config (no secrets), one line per app and one per target:
#   /etc/github-app-mint/apps.conf     <app> <app-id>
#   /etc/github-app-mint/targets.conf  <app> <owner> <file> <uid> <repos|-> <perm=level,...>
#     repos: comma-separated names of that owner's repositories, or - for all the installation has
# Keys: systemd credentials github-app.<app>.pem (files /etc/credstore/github-app.<app>.pem, root 600).
#
# Output files are written atomically (temporary file in the same folder, then rename), mode 600,
# owned by <uid>. A target that fails keeps its old file; the job exits 1 if any target failed.
# Tokens and keys never reach stdout, stderr, or a command line.
set -euo pipefail

VERSION_HEADER="X-GitHub-Api-Version: 2022-11-28"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

# jwt <app-id> <key-file>: RS256 token, issued 60 s in the past (clock skew), valid 9 minutes.
jwt() {
  local app_id=$1 key=$2 now h p s
  now=$(date +%s)
  h=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  p=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$app_id" | b64url)
  s=$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$key" -binary | b64url)
  printf '%s.%s.%s' "$h" "$p" "$s"
}

# body <repos> <perms>: the JSON for POST /app/installations/{id}/access_tokens.
body() {
  local repos=$1 perms=$2
  jq -cn --arg repos "$repos" --arg perms "$perms" '
    ( $perms | split(",") | map(select(length > 0) | split("=") | {(.[0]): .[1]}) | add // {} ) as $p
    | if $repos == "-" then {permissions: $p}
      else {repositories: ($repos | split(",") | map(select(length > 0))), permissions: $p} end'
}

# api <method> <path> <header-file> [body]: the Authorization header comes from a file (curl -H @file),
# so neither the JSON Web Token nor any token appears on a command line.
api() {
  local method=$1 path=$2 hdr=$3 data=${4:-}
  local args=(-sS --fail-with-body -X "$method" -H "Accept: application/vnd.github+json" -H "$VERSION_HEADER"
              -H "@$hdr" --max-time 30)
  [[ -n $data ]] && args+=(-H "Content-Type: application/json" --data "$data")
  curl "${args[@]}" "${GITHUB_API:-https://api.github.com}$path"
}

# write_token <file> <uid> <token-var-name>: atomic, mode 600, owned by uid.
write_token() {
  local file=$1 uid=$2 tmp
  tmp=$(mktemp "$(dirname "$file")/.github-app-token.XXXXXX")
  printf '%s\n' "${!3}" >"$tmp"
  chmod 600 "$tmp"
  chown "$uid" "$tmp"
  mv -f "$tmp" "$file"
}

main() {
  local cred=${CREDENTIALS_DIRECTORY:?no CREDENTIALS_DIRECTORY: run as the systemd unit}
  local conf=${GITHUB_APP_MINT_CONF_DIR:-/etc/github-app-mint} f failed=0 work
  for f in apps.conf targets.conf; do
    [[ -r $conf/$f ]] || { echo "missing $conf/$f" >&2; return 2; }
  done
  work=$(mktemp -d)
  GH_APP_WORK=$work  # global, so the EXIT trap still sees it after main returns
  trap 'rm -rf "${GH_APP_WORK:-}"' EXIT
  declare -A app_id inst_json

  while read -r app id _; do
    [[ -z ${app:-} || $app == \#* ]] && continue
    app_id[$app]=$id
  done <"$conf/apps.conf"

  while read -r app owner file uid repos perms _; do
    [[ -z ${app:-} || $app == \#* ]] && continue
    local key="$cred/github-app.$app.pem" hdr="$work/$app.hdr"
    if [[ -z ${app_id[$app]:-} || ! -r $key ]]; then
      echo "skip $app/$owner -> $file: no app id or no key github-app.$app.pem" >&2; failed=1; continue
    fi
    if [[ ! -s $hdr ]]; then  # one JSON Web Token per app per run
      printf 'Authorization: Bearer %s\n' "$(jwt "${app_id[$app]}" "$key")" >"$hdr"
      chmod 600 "$hdr"
    fi
    if [[ -z ${inst_json[$app]:-} ]]; then
      if ! inst_json[$app]=$(api GET "/app/installations?per_page=100" "$hdr"); then
        echo "fail $app: list installations" >&2; failed=1; continue
      fi
    fi
    local inst
    inst=$(jq -r --arg o "$owner" '.[] | select((.account.login | ascii_downcase) == ($o | ascii_downcase)) | .id' \
             <<<"${inst_json[$app]}" | head -n1)
    if [[ -z $inst ]]; then
      echo "fail $app/$owner -> $file: app not installed on $owner" >&2; failed=1; continue
    fi
    local resp token expires
    if ! resp=$(api POST "/app/installations/$inst/access_tokens" "$hdr" "$(body "$repos" "$perms")"); then
      echo "fail $app/$owner -> $file: $(jq -r '.message? // "request failed"' <<<"$resp" 2>/dev/null)" >&2
      failed=1; continue
    fi
    token=$(jq -r '.token // empty' <<<"$resp")
    expires=$(jq -r '.expires_at // "?"' <<<"$resp")
    unset resp
    if [[ -z $token ]]; then
      echo "fail $app/$owner -> $file: no token in the answer" >&2; failed=1; continue
    fi
    write_token "$file" "$uid" token
    unset token
    echo "ok $app/$owner -> $file (repos $repos; $perms; expires $expires)"
  done <"$conf/targets.conf"

  return $failed
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
