# Copy to /etc/github-mirror/mirror.env (root-owned, mode 644). No secrets here:
# the tokens are systemd credentials, files /etc/credstore/github-mirror.*.

# GitHub users and organisations whose repositories are mirrored, separated by spaces.
OWNERS="your-org your-user"

# The GitLab group that receives them (one subgroup per owner, one project per
# repository) and where GitLab answers from the machine that runs the job.
GITLAB_GROUP=github
GITLAB_URL=http://127.0.0.1:8929

# Bare mirrors, the clone of the metadata project and the status files.
STATE_DIR=/var/lib/github-mirror
