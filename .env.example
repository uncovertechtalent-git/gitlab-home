# Copy to .env next to docker-compose.yml. There are no secrets in this file.

# The image tag, pinned. Upgrades are one deliberate edit of this line
# (README.md, "Upgrade"): GitLab must move through its required stops.
GITLAB_VERSION=19.5.8-ce.0

# The name GitLab is served under, the one the reverse proxy answers to and
# the one git clone URLs carry. Must resolve on the LAN and on the tailnet.
GITLAB_HOSTNAME=gitlab.lan.example.org

# Host ports. The web port is bound to the loopback address only: the reverse
# proxy on the same machine is the one way to the web interface. The ssh port
# is bound to all interfaces (LAN and tailnet); no router port forward points
# at it. Check with ss -ltn that both are free.
GITLAB_HTTP_PORT=8929
GITLAB_SSH_PORT=2222

# Memory the container may use. The tuning in docker-compose.yml aims at about
# half of this in steady state.
GITLAB_MEM_LIMIT=16g

TZ=Europe/Berlin
